# RHDH RHEL 9 bootc + Quadlet (copied from ansible image_mode quadlet flow).

FROM registry.redhat.io/rhel9/rhel-bootc@sha256:092cb09985b367073243a716aa61cf86e4ee69f30fa943a64ac85c2ed8d09f6a

RUN dnf install -y nodejs npm python3 python3-pip python3-pyyaml curl sudo podman cloud-init openssl && \
    dnf clean all && \
    pip3 install --no-cache-dir mkdocs-techdocs-core==1.3.3

RUN useradd -r -u 1001 -g root -d /opt/app-root/src -s /sbin/nologin rhdh && \
    mkdir -p /opt/app-root/src /opt/app-root/src/dynamic-plugins-root /etc/rhdh /var/lib/rhdh /etc/containers /usr/local/lib/rhdh && \
    echo "rhdh ALL=(root) NOPASSWD: /usr/bin/chown, /usr/bin/chmod, /usr/bin/mkdir" > /etc/sudoers.d/rhdh && \
    dnf install -y openssh-server && \
    useradd -m -u 1000 -G wheel -s /bin/bash admin && \
    usermod -L admin && \
    systemctl enable sshd && \
    mkdir -p /etc/ssh/sshd_config.d && \
    printf '%s\n' \
      'PasswordAuthentication no' \
      'ChallengeResponseAuthentication no' \
      'PermitRootLogin prohibit-password' \
      'UsePAM yes' \
      'PubkeyAuthentication yes' \
      > /etc/ssh/sshd_config.d/10-disable-password-auth.conf && \
    chmod 644 /etc/ssh/sshd_config.d/10-disable-password-auth.conf && \
    echo '%wheel ALL=(ALL) NOPASSWD: ALL' >> /etc/sudoers

COPY ./configs /etc/rhdh/configs
COPY ./quadlet/rhdh.env /etc/rhdh/rhdh.env
COPY ./scripts/prepare-and-install-dynamic-plugins.sh /usr/local/bin/
COPY ./scripts/wait-for-plugins-and-start.sh /usr/local/bin/
COPY ./scripts/detect-and-set-base-url.sh /usr/local/bin/
COPY ./scripts/grant-postgres-createdb.sh /usr/local/bin/
COPY ./scripts/validate-external-postgres.sh /usr/local/bin/
COPY ./scripts/clean-plugin-lock.sh /usr/local/bin/
COPY ./scripts/lib/yaml-helper.py /usr/local/lib/rhdh/yaml-helper.py
COPY ./scripts/first-boot-config.sh /usr/local/bin/
COPY ./scripts/lib/common.sh /usr/local/lib/rhdh/common.sh
COPY ./scripts/lib/secrets-dropin.sh /usr/local/lib/rhdh/secrets-dropin.sh
COPY ./systemd/first-boot-config.service /etc/systemd/system/

COPY ./files/auth.json /etc/containers/auth.json
# systemd/Quadlet runs podman as root; root reads ~/.config/containers/auth.json, not /etc/containers alone
# Make auth.json readable by all users so RHDH container (user 1001) can use it for pulling plugins
RUN mkdir -p /root/.config/containers && \
    cp /etc/containers/auth.json /root/.config/containers/auth.json && \
    chmod 600 /root/.config/containers/auth.json && \
    chmod 644 /etc/containers/auth.json

COPY ./quadlet/rhdh.container /usr/share/containers/systemd/rhdh.container
COPY ./quadlet/postgres.container /usr/share/containers/systemd/postgres.container
COPY ./quadlet/rhdh-network.network /usr/share/containers/systemd/rhdh-network.network
COPY ./quadlet/postgres.env /etc/rhdh/postgres.env

# Air-gap note: container images are NOT pre-pulled in this Containerfile.
# For air-gapped deployments, bootc-image-builder embeds images when creating
# the QCOW2/ISO. For local testing, podman pulls images at runtime.

RUN chmod +x /usr/local/bin/prepare-and-install-dynamic-plugins.sh /usr/local/bin/wait-for-plugins-and-start.sh /usr/local/bin/detect-and-set-base-url.sh \
        /usr/local/bin/grant-postgres-createdb.sh /usr/local/bin/validate-external-postgres.sh /usr/local/bin/clean-plugin-lock.sh \
        /usr/local/bin/first-boot-config.sh && \
    chmod +x /usr/local/lib/rhdh/yaml-helper.py /usr/local/lib/rhdh/common.sh /usr/local/lib/rhdh/secrets-dropin.sh && \
    systemctl enable first-boot-config.service && \
    mkdir -p /etc/containers/systemd/rhdh.container.d /etc/containers/systemd/postgres.container.d && \
    mkdir -p /var/lib/rhdh/{dynamic-plugins-root,generated,config,.npm,scripts} && \
    mkdir -p /var/lib/rhdh/postgres-data && \
    mkdir -p /extensions && \
    cp /usr/local/bin/prepare-and-install-dynamic-plugins.sh /var/lib/rhdh/scripts/ && \
    cp /usr/local/bin/wait-for-plugins-and-start.sh /var/lib/rhdh/scripts/ && \
    cp /usr/local/bin/detect-and-set-base-url.sh /var/lib/rhdh/scripts/ && \
    chmod +x /var/lib/rhdh/scripts/*.sh && \
    if [ -f /etc/rhdh/configs/dynamic-plugins/dynamic-plugins.override.yaml ]; then \
        echo "Using dynamic-plugins.override.yaml"; \
        cp /etc/rhdh/configs/dynamic-plugins/dynamic-plugins.override.yaml /var/lib/rhdh/config/dynamic-plugins.yaml; \
    else \
        cp /etc/rhdh/configs/dynamic-plugins/dynamic-plugins.yaml /var/lib/rhdh/config/dynamic-plugins.yaml; \
    fi && \
    ln -sf /var/lib/rhdh/config/dynamic-plugins.yaml /var/lib/rhdh/dynamic-plugins-root/dynamic-plugins.yaml && \
    ln -sf /var/lib/rhdh/config/dynamic-plugins.yaml /var/lib/rhdh/dynamic-plugins.yaml && \
    sed -i 's|LINK_TARGET="/var/lib/rhdh/dynamic-plugins.yaml"|LINK_TARGET="/opt/app-root/src/dynamic-plugins.yaml"|' /var/lib/rhdh/scripts/prepare-and-install-dynamic-plugins.sh && \
    chown -R 1001:0 /opt/app-root /var/lib/rhdh /etc/rhdh /extensions && \
    chmod -R g=u /opt/app-root /var/lib/rhdh /etc/rhdh /extensions && \
    chown 26:26 /var/lib/rhdh/postgres-data && \
    chmod 700 /var/lib/rhdh/postgres-data && \
    chmod 644 /usr/share/containers/systemd/rhdh.container

RUN printf '%s\n' \
  '#!/bin/bash' \
  'echo "=== RHDH + PostgreSQL Health Check ==="' \
  'if systemctl is-active --quiet postgres.service; then echo "✓ PostgreSQL service active"; else echo "✗ PostgreSQL service not active"; exit 1; fi' \
  'podman exec rhdh-postgres pg_isready -U postgres >/dev/null 2>&1 || { echo "✗ PostgreSQL database not ready"; exit 1; }' \
  'echo "✓ PostgreSQL database ready"' \
  'if systemctl is-active --quiet rhdh.service; then echo "✓ RHDH service active"; else echo "✗ RHDH service not active"; exit 1; fi' \
  'curl -f http://localhost:7007 >/dev/null 2>&1 || { echo "✗ RHDH backend not responding"; exit 1; }' \
  'echo "✓ RHDH backend healthy"' \
  'echo "=== Health check passed ==="' \
  > /usr/local/bin/health-check.sh && chmod +x /usr/local/bin/health-check.sh

EXPOSE 7007 5432
WORKDIR /opt/app-root/src
CMD ["/usr/sbin/init"]
