# =============================================================================
# RHDH (Red Hat Developer Hub) Environment Configuration
# =============================================================================

# Core RHDH Configuration
NODE_TLS_REJECT_UNAUTHORIZED=0

# Registry Authentication
# Points skopeo to the Red Hat registry auth file for pulling plugin catalog index
REGISTRY_AUTH_FILE=/etc/containers/auth.json

# Plugin Catalog Index (RHDH 1.9+)
# Used by Extensions plugin for dynamic plugin installation
# WARNING: This causes 15-20 minute startup times on first run (downloads 50+ plugins)
# Subsequent startups are faster once plugins are cached
CATALOG_INDEX_IMAGE=registry.access.redhat.com/rhdh/plugin-catalog-index@sha256:7685bc0f28b4ae5fe41bb60bb807700be8572cc3a1d39c12cf5f82955684134c
CATALOG_ENTITIES_EXTRACT_DIR=/extensions

# Branding Configuration
# Note: Color variables are intentionally not set to use RHDH default branding (matching rhdh-local)
# Uncomment and customize these values if you need custom branding:
# PRIMARY_LIGHT_COLOR=#your-color
# HEADER_LIGHT_COLOR_1=#your-color
# HEADER_LIGHT_COLOR_2=#your-color
# NAV_INDICATOR_LIGHT_COLOR=#your-color
# PRIMARY_DARK_COLOR=#your-color
# HEADER_DARK_COLOR_1=#your-color
# HEADER_DARK_COLOR_2=#your-color
# NAV_INDICATOR_DARK_COLOR=#your-color
FULL_LOGO_WIDTH=110px

# BASE_URL Configuration
# ----------------------
# Auto-detect container IP at startup (detect-and-set-base-url.sh)
# Use EXTERNAL_URL to lock BASE_URL (for proxy/OpenShift scenarios)
# EXTERNAL_URL=http://your-static-ip:7007
#
BASE_URL=http://localhost:7007
NODE_OPTIONS=--no-node-snapshot

# Authentication Provider Override
# DO NOT set to true - that DISABLES the default auth providers!
# Leave commented out OR set to false to enable auth providers from app-config.yaml
# ENABLE_AUTH_PROVIDER_MODULE_OVERRIDE=false

# Logging Configuration  
# LOG_LEVEL=debug

# Analytics Configuration (Segment)
SEGMENT_WRITE_KEY=<SEGMENT_WRITE_KEY>

# Backend Authentication
# BACKEND_SECRET is not required for development with guest authentication
# For production with real auth providers, uncomment and set a strong secret:
# BACKEND_SECRET=your-production-secret-here

# =============================================================================
# DATABASE CONFIGURATION - PostgreSQL Container
# =============================================================================

# PostgreSQL Database Configuration (container)
# NOTE: Using postgres superuser for POC/demo purposes
# Backstage creates per-plugin databases (backstage_plugin_*) which requires CREATEDB privilege
# Production deployments should create a dedicated user with CREATEDB or pre-create all plugin databases
POSTGRES_HOST=rhdh-postgres
POSTGRES_PORT=5432
POSTGRES_USER=postgres
POSTGRES_PASSWORD=secure_admin_password_123
POSTGRES_DB=rhdh_backstage

# Backstage Database Client Configuration
BACKEND_DATABASE_CLIENT=pg
BACKEND_DATABASE_CONNECTION_HOST=rhdh-postgres
BACKEND_DATABASE_CONNECTION_PORT=5432
BACKEND_DATABASE_CONNECTION_USER=postgres
BACKEND_DATABASE_CONNECTION_PASSWORD=secure_admin_password_123
BACKEND_DATABASE_CONNECTION_DATABASE=rhdh_backstage

# SSL Configuration (not needed for container-to-container)
BACKEND_DATABASE_CONNECTION_SSL=false

# =============================================================================
# External Integrations
# =============================================================================

# GitHub Integration - Three Types:
#
# 1. Personal Access Token (for catalog ingestion, preventing rate limits)
#    Create at: https://github.com/settings/tokens
#    Scopes needed: read:org, repo
# GITHUB_TOKEN=demo-github-token

# 2. OAuth App (for user authentication - sign in with GitHub)
#    Create OAuth App at: https://github.com/settings/developers
#    Callback URL: http://<your-ip>:7007/api/auth/github/handler/frame
# GITHUB_CLIENT_ID=<your-github-client-id>
# GITHUB_CLIENT_SECRET=<your-github-client-secret>

# 3. GitHub App (OPTIONAL - for scaffolder creating repos)
#    Only needed if you want templates to create GitHub repositories
#    Generate using: npx @backstage/cli create-github-app <org-name>
#    Then configure in configs/extra-files/github-app-credentials.yaml
# GITHUB_APP_APP_ID=
# GITHUB_APP_CLIENT_ID=
# GITHUB_APP_CLIENT_SECRET=
# GITHUB_APP_WEBHOOK_SECRET=
# GITHUB_APP_PRIVATE_KEY=

# GitLab Integration
# GITLAB_TOKEN=demo-gitlab-token


# =============================================================================
# NOTES:
# - Direct values used (Podman --env-file doesn't process ${VAR:-default} syntax)
# - BASE_URL is auto-detected at container startup based on VM's IP address
# - Database configured for PostgreSQL via container (rhdh-postgres)
# =============================================================================