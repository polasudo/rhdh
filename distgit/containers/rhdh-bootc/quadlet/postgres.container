# Podman Quadlet .container file for PostgreSQL
[Unit]
Description=PostgreSQL Database for RHDH
After=network-online.target
Wants=network-online.target

[Container]
Image=registry.redhat.io/rhel9/postgresql-15@sha256:9606363cb215fc3e23e55d703a6e4fb8cbe277ad511c9daa776053aec595750a
ContainerName=rhdh-postgres
SecurityLabelDisable=true

# Environment variables from file
EnvironmentFile=/etc/rhdh/postgres.env

# Persistent storage (bind mount to /var for immutable OS compliance)
Volume=/var/lib/rhdh/postgres-data:/var/lib/pgsql/data:Z

# Network (localhost only — RHDH connects via container network DNS)
Network=rhdh-network
PublishPort=127.0.0.1:5432:5432

# Health check
HealthCmd=/bin/bash -c 'pg_isready -U rhdh_user -d rhdh_backstage'
HealthInterval=30s
HealthTimeout=10s
HealthRetries=3

[Service]
# Only start if using local PostgreSQL (not external).
# If POSTGRES_HOST in rhdh.env is changed from rhdh-postgres, this container is skipped.
ExecCondition=/bin/bash -c 'host=$(grep "^POSTGRES_HOST=" /etc/rhdh/rhdh.env | cut -d= -f2); [ -z "$host" ] || [ "$host" = "rhdh-postgres" ]'
# Grant CREATEDB privilege to application user after container starts
ExecStartPost=/usr/local/bin/grant-postgres-createdb.sh
Restart=always
RestartSec=10
TimeoutStartSec=900

[Install]
WantedBy=multi-user.target default.target
