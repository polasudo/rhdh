# Podman Quadlet unit for PostgreSQL (RHDH backing store)
# Base image definition — Ansible layers add credentials via Podman secrets or env overrides.
[Unit]
Description=PostgreSQL Database for RHDH
After=network-online.target first-boot-config.service
Wants=network-online.target

[Container]
Image=registry.redhat.io/rhel9/postgresql-15@sha256:9606363cb215fc3e23e55d703a6e4fb8cbe277ad511c9daa776053aec595750a
ContainerName=rhdh-postgres
EnvironmentFile=/etc/rhdh/postgres.env
Volume=postgres-data:/var/lib/pgsql/data:Z
Network=rhdh-network

HealthCmd=/bin/bash -c 'pg_isready -U postgres'
HealthInterval=30s
HealthTimeout=10s
HealthRetries=3

[Service]
Restart=always
RestartSec=10
TimeoutStartSec=900

[Install]
WantedBy=multi-user.target default.target
