# PostgreSQL Configuration
# Change these credentials per deployment. Do not use the defaults in production.
POSTGRESQL_USER=rhdh_user
POSTGRESQL_PASSWORD=CHANGE_ME_RHDH_DB_PASSWORD
POSTGRESQL_DATABASE=rhdh_backstage
POSTGRESQL_ADMIN_PASSWORD=CHANGE_ME_POSTGRES_ADMIN_PASSWORD

# Additional PostgreSQL settings
POSTGRESQL_MAX_CONNECTIONS=100
POSTGRESQL_SHARED_BUFFERS=256MB
POSTGRESQL_EFFECTIVE_CACHE_SIZE=1GB
