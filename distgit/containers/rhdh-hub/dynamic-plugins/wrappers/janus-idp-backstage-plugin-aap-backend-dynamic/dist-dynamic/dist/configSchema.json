              "type": "object",
              "additionalProperties": {
                "type": "object",
                "required": [
                  "authorization",
                  "baseUrl"
                ],
                "properties": {
                  "baseUrl": {
                    "description": "AapConfig",
                    "type": "string"
                  },
                  "authorization": {
                    "visibility": "secret",
                    "type": "string"
                  },
                  "system": {
                    "type": "string"
                  },
                  "owner": {
                    "type": "string"
                  },
                  "schedule": {}
                }
              }
            }
          }
        }
      }
    }
  }
}
