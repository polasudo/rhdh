{
  "name": "@red-hat-developer-hub/backstage-plugin-bulk-import-backend",
  "version": "5.2.0+embedded",
  "main": "./dist/index.cjs.js",
  "types": "./dist/index.d.ts",
  "license": "Apache-2.0",
  "publishConfig": {
    "access": "public"
  },
  "backstage": {
    "role": "backend-plugin",
    "supported-versions": "1.32.5",
    "pluginId": "bulk-import",
    "pluginPackages": [
      "@red-hat-developer-hub/backstage-plugin-bulk-import",
      "@red-hat-developer-hub/backstage-plugin-bulk-import-backend",
      "@red-hat-developer-hub/backstage-plugin-bulk-import-common"
    ]
  },
  "exports": {
    ".": {
      "backstage": "@backstage/BackendFeature",
      "require": "./dist/index.cjs.js",
      "types": "./dist/index.d.ts",
      "default": "./dist/index.cjs.js"
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "backstage-cli package build",
    "clean": "backstage-cli package clean",
    "lint:check": "backstage-cli package lint",
    "lint:fix": "backstage-cli package lint --fix",
    "postpack": "backstage-cli package postpack",
    "prepack": "backstage-cli package prepack",
    "start": "backstage-cli package start",
    "test": "backstage-cli package test --passWithNoTests --coverage --detectOpenHandles",
    "tsc": "tsc",
    "prettier:check": "prettier --ignore-unknown --check .",
    "prettier:fix": "prettier --ignore-unknown --write .",
    "openapi": "./scripts/openapi.sh"
  },
  "dependencies": {
    "@octokit/auth-app": "^6.0.3",
    "@octokit/rest": "^20.0.2",
    "@red-hat-developer-hub/backstage-plugin-bulk-import-common": "^1.4.1",
    "ajv-formats": "^3.0.1",
    "express": "^4.17.1",
    "git-url-parse": "^14.0.0",
    "js-yaml": "^4.1.0",
    "luxon": "^3.4.4",
    "node-fetch": "^2.6.7",
    "openapi-backend": "^5.10.6"
  },
  "devDependencies": {},
  "peerDependencies": {
    "@janus-idp/backstage-plugin-audit-log-node": "^1.7.0",
    "@backstage/backend-defaults": "^0.5.2",
    "@backstage/backend-plugin-api": "^1.0.1",
    "@backstage/errors": "^1.2.4",
    "@backstage/integration": "^1.15.1",
    "@backstage/plugin-catalog-node": "^1.13.1",
    "@backstage/plugin-permission-common": "^0.8.1",
    "@backstage/plugin-permission-node": "^0.8.4"
  },
  "files": [
    "dist",
    "config.d.ts",
    "app-config.yaml"
  ],
  "configSchema": "config.d.ts",
  "repository": {
    "type": "git",
    "url": "https://github.com/redhat-developer/rhdh-plugins",
    "directory": "workspaces/bulk-import/plugins/bulk-import-backend"
  },
  "keywords": [
    "support:tech-preview",
    "lifecycle:active",
    "backstage",
    "plugin"
  ],
  "homepage": "https://red.ht/rhdh",
  "bugs": "https://github.com/redhat-developer/rhdh-plugins/issues",
  "maintainers": [
    "@rm3l"
  ],
  "author": "Red Hat",
  "private": true,
  "overrides": {
    "@aws-sdk/util-utf8-browser": {
      "@smithy/util-utf8": "^2.0.0"
    }
  },
  "resolutions": {
    "@aws-sdk/util-utf8-browser": "npm:@smithy/util-utf8@~2"
  }
}
