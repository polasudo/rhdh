{
  "type": "object",
  "required": [
    "notifications"
  ],
  "$schema": "http://json-schema.org/draft-07/schema#",
  "properties": {
    "notifications": {
      "description": "Configuration options for notifications-backend-module-email",
      "type": "object",
      "required": [
        "processors"
      ],
      "properties": {
        "processors": {
          "type": "object",
          "required": [
            "email"
          ],
          "properties": {
            "email": {
              "type": "object",
              "required": [
                "sender",
                "transportConfig"
              ],
              "properties": {
                "transportConfig": {
                  "description": "Transport to use for sending emails",
                  "anyOf": [
                    {
                      "type": "object",
                      "properties": {
                        "transport": {
                          "type": "string",
                          "const": "smtp"
                        },
                        "hostname": {
                          "description": "SMTP server hostname",
                          "type": "string"
                        },
                        "port": {
                          "description": "SMTP server port",
                          "type": "number"
                        },
                        "secure": {
                          "description": "Use secure connection for SMTP, defaults to false",
                          "type": "boolean"
                        },
                        "requireTls": {
                          "description": "Require TLS for SMTP connection, defaults to false",
                          "type": "boolean"
                        },
                        "username": {
                          "description": "SMTP username",
                          "type": "string"
                        },
                        "password": {
                          "description": "SMTP password",
                          "visibility": "secret",
                          "type": "string"
                        }
                      },
                      "required": [
                        "hostname",
                        "port",
                        "transport"
                      ]
                    },
                    {
                      "type": "object",
                      "properties": {
                        "transport": {
                          "type": "string",
                          "const": "ses"
                        },
                        "apiVersion": {
                          "description": "SES ApiVersion to use, defaults to 2010-12-01",
                          "type": "string"
                        },
                        "accountId": {
                          "description": "AWS account ID to use",
                          "type": "string"
                        },
                        "region": {
                          "description": "AWS region to use",
                          "type": "string"
                        }
                      },
                      "required": [
                        "transport"
                      ]
                    },
                    {
                      "type": "object",
                      "properties": {
                        "transport": {
                          "type": "string",
                          "const": "sendmail"
                        },
                        "path": {
                          "description": "Sendmail binary path, defaults to /usr/sbin/sendmail",
                          "type": "string"
                        },
                        "newline": {
                          "description": "Newline style, defaults to 'unix'",
                          "enum": [
                            "unix",
                            "windows"
                          ],
                          "type": "string"
                        }
                      },
                      "required": [
                        "transport"
                      ]
                    },
                    {
                      "type": "object",
                      "properties": {
                        "transport": {
                          "description": "Only for debugging, disables the actual sending of emails",
                          "type": "string",
                          "const": "stream"
                        }
                      },
                      "required": [
                        "transport"
                      ]
                    }
                  ]
                },
                "sender": {
                  "description": "Sender email address",
                  "type": "string"
                },
                "replyTo": {
                  "description": "Optional reply-to address",
                  "type": "string"
                },
                "concurrencyLimit": {
                  "description": "Concurrency limit for email sending, defaults to 2",
                  "type": "number"
                },
                "throttleInterval": {
                  "description": "Throttle duration between email sending, defaults to 100ms"
                },
                "broadcastConfig": {
                  "description": "Configuration for broadcast notifications",
                  "type": "object",
                  "required": [
                    "receiver"
                  ],
                  "properties": {
                    "receiver": {
                      "description": "Receiver of the broadcast notifications:\nnone - skips sending\nusers - sends to all users in backstage, might have performance impact\nconfig - sends to the emails specified in the config",
                      "enum": [
                        "config",
                        "none",
                        "users"
                      ],
                      "type": "string"
                    },
                    "receiverEmails": {
                      "description": "Broadcast notification receivers when receiver is set to config",
                      "type": "array",
                      "items": {
                        "type": "string"
                      }
                    }
                  }
                },
                "cache": {
                  "type": "object",
                  "properties": {
                    "ttl": {
                      "description": "Email cache TTL, defaults to 1 hour"
                    }
                  }
                },
                "filter": {
                  "type": "object",
                  "properties": {
                    "minSeverity": {
                      "description": "Minimum severity. A notification with lower severity will not be emailed"
                    },
                    "maxSeverity": {
                      "description": "Maximum severity. A notification with higher severity will not be emailed"
                    },
                    "excludedTopics": {
                      "description": "A notification who's topic is in this array will not be emailed",
                      "type": "array",
                      "items": {
                        "type": "string"
                      }
                    }
                  }
                },
                "allowlistEmailAddresses": {
                  "description": "White list of addresses to send email to",
                  "type": "array",
                  "items": {
                    "type": "string"
                  }
                },
                "denylistEmailAddresses": {
                  "description": "Black list of addresses to not send email to",
                  "type": "array",
                  "items": {
                    "type": "string"
                  }
                }
              }
            }
          }
        }
      }
    },
    "events": {
      "type": "object",
      "properties": {
        "useEventBus": {
          "description": "Whether to use the event bus API in the events plugin backend to\ndistribute events across multiple instances when publishing and\nsubscribing to events.\n\nThe default is 'auto', which means means that the event bus API will be\nused if it's available, but will be disabled if the events backend\nreturns a 404.\n\nIf set to 'never', the events service will only ever publish events\nlocally to the same instance, while if set to 'always', the event bus API\nwill never be disabled, even if the events backend returns a 404.",
          "enum": [
            "always",
            "auto",
            "never"
          ],
          "type": "string"
        }
      }
    }
  }
}
