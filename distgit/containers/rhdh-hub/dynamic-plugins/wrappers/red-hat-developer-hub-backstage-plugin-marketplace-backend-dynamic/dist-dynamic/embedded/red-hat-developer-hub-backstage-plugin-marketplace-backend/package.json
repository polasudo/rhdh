{
  "name": "@red-hat-developer-hub/backstage-plugin-marketplace-backend",
  "version": "0.3.1+embedded",
  "main": "dist/index.cjs.js",
  "types": "dist/index.d.ts",
  "license": "Apache-2.0",
  "publishConfig": {
    "access": "public",
    "main": "dist/index.cjs.js",
    "types": "dist/index.d.ts"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/redhat-developer/rhdh-plugins",
    "directory": "workspaces/marketplace/plugins/marketplace-backend"
  },
  "backstage": {
    "role": "backend-plugin",
    "pluginId": "marketplace",
    "pluginPackages": [
      "@red-hat-developer-hub/backstage-plugin-marketplace",
      "@red-hat-developer-hub/backstage-plugin-marketplace-backend",
      "@red-hat-developer-hub/backstage-plugin-marketplace-common"
    ],
    "features": {
      ".": "@backstage/BackendFeature"
    }
  },
  "scripts": {
    "start": "backstage-cli package start",
    "build": "backstage-cli package build",
    "lint": "backstage-cli package lint",
    "test": "backstage-cli package test --coverage --detectOpenHandles",
    "clean": "backstage-cli package clean",
    "prepack": "backstage-cli package prepack",
    "postpack": "backstage-cli package postpack"
  },
  "dependencies": {
    "@red-hat-developer-hub/backstage-plugin-marketplace-common": "^0.3.0",
    "express": "^4.17.1",
    "express-promise-router": "^4.1.0"
  },
  "devDependencies": {},
  "files": [
    "dist"
  ],
  "typesVersions": {
    "*": {
      "index": [
        "dist/index.d.ts"
      ]
    }
  },
  "private": true,
  "peerDependencies": {
    "@backstage/backend-defaults": "^0.8.1",
    "@backstage/backend-plugin-api": "^1.2.0",
    "@backstage/catalog-client": "^1.9.1",
    "@backstage/catalog-model": "^1.7.3",
    "@backstage/errors": "^1.2.7",
    "@backstage/plugin-catalog-node": "^1.16.0"
  },
  "overrides": {
    "@aws-sdk/util-utf8-browser": {
      "@smithy/util-utf8": "^2.0.0"
    }
  },
  "resolutions": {
    "@aws-sdk/util-utf8-browser": "npm:@smithy/util-utf8@~2"
  }
}
