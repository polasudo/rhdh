{
  "type": "object",
  "$schema": "http://json-schema.org/draft-07/schema#",
  "properties": {
    "catalog": {
      "type": "object",
      "properties": {
        "providers": {
          "type": "object",
          "properties": {
            "pingIdentityOrg": {
              "type": "object",
              "additionalProperties": {
                "type": "object",
                "required": [
                  "apiPath",
                  "authPath",
                  "clientId",
                  "clientSecret",
                  "envId"
                ],
                "properties": {
                  "apiPath": {
                    "description": "The PingOne API path",
                    "type": "string"
                  },
                  "authPath": {
                    "description": "The PingOne Auth path",
                    "type": "string"
                  },
                  "envId": {
                    "description": "The envId where the application is located",
                    "type": "string"
                  },
                  "clientId": {
                    "description": "Ping Identity credentials. Use together with \"clientSecret\".",
                    "type": "string"
                  },
                  "clientSecret": {
                    "description": "Ping Identity credentials. Use together with \"clientId\".",
                    "visibility": "secret",
                    "type": "string"
                  },
                  "schedule": {
                    "description": "Schedule configuration for refresh tasks."
                  },
                  "userQuerySize": {
                    "description": "The number of users to query at a time.",
                    "type": "number"
                  },
                  "groupQuerySize": {
                    "description": "The number of groups to query at a time.",
                    "type": "number"
                  }
                }
              }
            }
          }
        }
      }
    }
  }
}
