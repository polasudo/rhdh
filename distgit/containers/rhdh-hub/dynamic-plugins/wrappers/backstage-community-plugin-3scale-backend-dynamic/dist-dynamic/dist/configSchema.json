{
  "type": "object",
  "$schema": "http://json-schema.org/draft-07/schema#",
  "properties": {
    "catalog": {
      "type": "object",
      "properties": {
        "providers": {
          "type": "object",
          "properties": {
            "threeScaleApiEntity": {
              "type": "object",
              "additionalProperties": {
                "type": "object",
                "required": [
                  "accessToken",
                  "baseUrl"
                ],
                "properties": {
                  "baseUrl": {
                    "description": "ThreeScaleConfig",
                    "type": "string"
                  },
                  "accessToken": {
                    "visibility": "secret",
                    "type": "string"
                  },
                  "systemLabel": {
                    "type": "string"
                  },
                  "ownerLabel": {
                    "type": "string"
                  },
                  "addLabels": {
                    "type": "boolean"
                  },
                  "schedule": {}
                }
              }
            }
          }
        }
      }
    }
  }
}
