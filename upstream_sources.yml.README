# this file exists because CPaaS midtreaming/usrc removes comments from the upstream_sources.yml file
# and that's just dumb.

# see https://cpaas.pages.redhat.com/documentation/users/midstream/usrc_updater.html#_enable_cachito
git:
-# CI_CPAAS_RHDH_HUB_UPSTREAM for the hub, operator, and bundle containers
- automerge: 'yes'
  # this becomes CI_CPAAS_RHDH_HUB_UPSTREAM_URL in container.yaml.in
  # upstream
  # url: https://github.com/janus-idp/backstage-showcase.git
  # midstream fork of backstage-showcase with RH branding
  url: https://gitlab.cee.redhat.com/rhidp/cpaas-rhdh-hub.git
  branch: rhdh-1-rhel-9
  commit: <sha from upstream, updated by CPaaS automatically>
  # see https://cpaas.pages.redhat.com/documentation/users/midstream/usrc_updater.html#_update_policy
  # if using tags, we can restrict downstreaming
  # tag_filter: v0.1.*
  update_policy:
  - latest
  # - tagged

  # https://cpaas.pages.redhat.com/documentation/users/midstream/usrc_updater.html#_downloading_files_from_upstream_directories
  # dest_formats:
  #   files:
  #     files_dest_dir: distgit/containers/rhdh-hub
      # filter_pattern:
        # - '*'
