{
  "extends": [
    "github>konflux-ci/mintmaker//config/renovate/renovate.json"
  ],
  "ignorePaths": [
    "**/distgit/containers/**",
    "**/sync/**",
    "**/upstream_sources.yml",
    ".gitlab-ci.yml",
    "catalogs/**/catalog-template.json",
    "catalogs/**/Containerfile",
    "catalogs/**/configs/rhdh/catalog.json",
    "build/containerfiles/gitlab-runner.Containerfile"
  ],
  "ignoreDeps": [
    "registry.redhat.io/openshift4/ose-operator-registry",
    "registry.redhat.io/openshift4/ose-operator-registry-rhel9"
  ],
  "packageRules": [
    {
      "matchCategories": [
        "docker"
      ],
      "digest": {
        "enabled": true
      }
    },
    {
      "matchDatasources": [
        "docker"
      ],
      "groupName": "Containerfile base images"
    }
  ],
  "dockerfile": {
    "enabled": true,
    "groupName": "Containerfile references [ci skip]",
    "additionalBranchPrefix": "{{parentDir}}-",
    "automerge": false,
    "managerFilePatterns": [
      "/Containerfile/"
    ],
    "includePaths": [
      "distgit/containers/**"
    ]
  },
  "lockFileMaintenance": {
    "enabled": false
  },
  "tekton": {
    "managerFilePatterns": [
      "/\\.yaml$/",
      "/\\.yml$/"
    ],
    "includePaths": [
      ".tekton/**",
      ".tekton-templates/**"
    ],
    "packageRules": [
      {
        "excludeCommitPaths": [
          "sync/upstream_SHA*",
          "upstream_sources.yml"
        ],
        "enabled": true,
        "additionalBranchPrefix": "{{parentDir}}-",
        "groupName": "Konflux references [ci skip]",
        "automerge": false,
        "branchPrefix": "konflux/references/",
        "group": {
          "branchTopic": "{{{baseBranch}}}",
          "commitMessageTopic": "{{{groupName}}}"
        },
        "commitMessageTopic": "Konflux references",
        "semanticCommits": "enabled",
        "prFooter": "To execute skipped test pipelines write comment `/ok-to-test`",
        "prBodyColumns": [
          "Package",
          "Change",
          "Notes"
        ],
        "prBodyDefinitions": {
          "Notes": "{{#if (or (containsString updateType 'minor') (containsString updateType 'major'))}}:warning:[migration](https://github.com/redhat-appstudio/build-definitions/blob/main/task/{{{replace '^quay.io/(redhat-appstudio-tekton-catalog|konflux-ci/tekton-catalog)/task-' '' packageName}}}/{{{newVersion}}}/MIGRATION.md):warning:{{/if}}"
        },
        "prBodyTemplate": "{{{header}}}{{{table}}}{{{notes}}}{{{changelogs}}}{{{controls}}}{{{footer}}}",
        "recreateWhen": "always",
        "rebaseWhen": "behind-base-branch",
        "matchPackageNames": [
          "/^quay.io/redhat-appstudio-tekton-catalog//",
          "/^quay.io/konflux-ci/tekton-catalog//"
        ]
      }
    ],
    "description": "Schedule during typical non-office hours on weekdays (i.e., 10 PM - 5 AM) and anytime on weekends",
    "schedule": [
      "* 0-4,22-23 * * 1-5",
      "* * * * 0,6"
    ]
  }
}
